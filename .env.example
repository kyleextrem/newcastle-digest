# Beehiiv API (server-only; used by /api/beehiiv?type=issues and ?type=latest)
# Get your API key and publication ID from the Beehiiv dashboard.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Sanity CMS — Newcastle Digest Journal
# Project ID: https://www.sanity.io/manage → select project → Project ID
# Dataset: usually "production" (Manage → Datasets)
# API Token: Manage → API → Tokens → create a token with Viewer (read) or Editor (read/write) access
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_token

# Stripe. One-time reader support at /support, and the custom shop at /shop.
# Server-only. Never prefix these with NEXT_PUBLIC_.
# Use a restricted key (rk_) with Checkout Sessions read/write, Refunds write,
# and Payment Intents read, or a full sk_ key. Shop checkout starts only when
# this key is sk_/rk_ live or test AND STRIPE_WEBHOOK_SECRET is set.
# The session livemode must match this key. /support uses the same key and product ID.
# Create one Product in the Stripe Dashboard named "Support Newcastle Digest" and paste its ID.
# Do not create a Price. Each contribution sets its own one-time amount.
STRIPE_SECRET_KEY=
STRIPE_SUPPORT_PRODUCT_ID=
# Production: Stripe Dashboard webhook signing secret for
# https://www.newcastledigest.com/api/stripe/webhook
# (checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired,
# payment_intent.succeeded). Do not paste a `stripe listen` secret into Vercel.
# Local live tests: `stripe listen --live --forward-to localhost:3004/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
# Optional origin for Stripe return URLs. Local defaults to http://localhost:PORT.
# Production uses https://www.newcastledigest.com unless this is set.
# SHOP_CHECKOUT_ORIGIN=http://localhost:3004
# Vercel Cron bearer token for /api/shop/cron/release-reservations.
# Required in Vercel production or the daily reservation cleanup returns 401.
# vercel.json runs this once a day (Hobby-safe). Expired Checkout Sessions
# are still released immediately by the Stripe webhook.
CRON_SECRET=

# Shop admin. Auth.js Google OAuth. Server-only.
# Production AUTH_URL must be https://www.newcastledigest.com
# and Google must allow https://www.newcastledigest.com/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3004
SHOP_ADMIN_EMAILS=

# Resend. Same provider as other Newcastle Digest apps. Server-only.
# Shop order confirmation and dispatch emails are sent after payment/fulfilment
# and are not required for checkout to succeed.
RESEND_API_KEY=
# Optional. Defaults to Newcastle Digest <notifications@newcastledigest.com>
# SHOP_EMAIL_FROM=Newcastle Digest <notifications@newcastledigest.com>

# Google Analytics 4. Public measurement ID. Falls back to G-XK7000CZS7 when unset.
# The tag is not loaded on localhost, /studio, or /api.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XK7000CZS7
